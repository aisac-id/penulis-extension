{
  "manifest_version": 3,
  "name": "Kalam — Harness Extension untuk Penulis Buku",
  "version": "1.0.0",
  "description": "Ruang kerja penulis buku di sidebar Chrome: naskah & bab, papan rencana, bible karakter/dunia, riset terkutip, target kata, analisis gaya, ekspor EPUB/DOCX, asisten AI, RPA. Patuh Harness v1.5.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "alarms", "downloads", "contextMenus"],
  "optional_permissions": ["nativeMessaging", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background/ServiceWorker.js", "type": "module" },
  "action": {
    "default_title": "Kalam — buka ruang kerja penulis (Alt+Shift+S)",
    "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" }
  },
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "options_ui": { "page": "studio/index.html", "open_in_tab": true },
  "commands": {
    "toggle-sidebar": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Buka/tutup sidebar Kalam (rail ↔ sidebar)" },
    "toggle-fullscreen": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Mode layar penuh Kalam" },
    "open-studio": { "description": "Buka Kalam Studio di tab baru" }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/*.css", "assets/*", "demo/*", "demo/img/*", "sidebar/*", "sidebar/ui/*", "sidebar/panels/*", "content/*", "docs/*", "core/*", "model/*", "analysis/*", "editor/*", "llm/*", "llm/providers/*", "rpa/*", "scrapers/*", "pipeline/*", "connectors/*", "connectors/web/*", "license/*", "onboarding/*", "studio/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}