# Kalam — contoh berkas rahasia.
# Salin menjadi .env lalu isi. Jangan pernah commit .env (sudah diblok .gitignore).
# Di extension: Pengaturan → Rahasia → "Impor .env". Semua nilai masuk SecretVault
# (AES-GCM 256 + PBKDF2 600.000 putaran) dan hanya tersimpan sebagai ciphertext.

# --- Penyedia AI (opsional; tanpa kunci pun asisten lokal tetap jalan) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Platform Bridge (opsional, default OFF) ---
KALAM_PLATFORM_URL=
KALAM_INGEST_TOKEN=

# --- Local Bridge / CLI loopback (opsional, default OFF) ---
KALAM_PAIRING_TOKEN=

# --- Lisensi (opsional) ---
KALAM_LICENSE_KEY=